# Dependencies
node_modules/

# Next.js
.next/
out/

# TypeScript
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Local runtime data
data/*
!data/.gitkeep
output/*
!output/.gitkeep
reports/*
!reports/.gitkeep

# Personal assets — resume PDFs and any uploaded files
assets/*
!assets/.gitkeep

# Personal portals config — your curated company list and title filters.
# portals.example.yml ships with the repo as the public default.
config/portals.yml

# Personal local config — the boards you scan and how their labels render.
# The matching *.example.json files ship with the repo as public defaults.
config/*.local.json

# Internal planning docs — historical notes, personal references, archived phases.
# These stay local; they are not part of the public repo.
docs/archive/

# Claude Code local config — personal settings stay out, shared skills ship.
# CLAUDE.md and AGENTS.md both point contributors at .claude/skills/, so those
# files have to be in the repo or the rules reference something nobody has.
.claude/*
!.claude/skills/

# Personal notes / resume text dumps
memory/
*.txt
docs/links.txt

# System files
.DS_Store
